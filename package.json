{
  "name": "gravatar-squid",
  "private": true,
  "scripts": {
    "build": "rm -rf lib && tsc",
    "update": "npx npm-check-updates --filter /subsquid/ --upgrade && npm i -f",
    "db:migrate": "npx squid-typeorm-migration apply",
    "squid-etl:start": "node lib/main.js",
    "squid-api:start": "squid-graphql-server"
  },
  "dependencies": {
    "@subsquid/batch-processor": "^1.1.0",
    "@subsquid/evm-abi": "^1.0.0",
    "@subsquid/evm-objects": "^0.0.3",
    "@subsquid/evm-stream": "^0.1.3",
    "@subsquid/graphql-server": "^4.12.1",
    "@subsquid/logger": "^1.6.0",
    "@subsquid/typeorm-migration": "^1.4.0",
    "@subsquid/typeorm-store": "^1.9.1",
    "@subsquid/util-internal-hex": "^1.2.3",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@subsquid/evm-typegen": "^5.0.0",
    "@subsquid/typeorm-codegen": "^2.4.0",
    "@types/node": "^24.13.3",
    "typescript": "~5.9.3"
  }
}
